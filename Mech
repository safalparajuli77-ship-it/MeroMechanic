        // INBUILT GEMINI AI ASSISTANT LOGIC
        async function handleAIChatSubmit(e) {
            e.preventDefault();
            const inputEl = document.getElementById('ai-chat-input');
            const userPrompt = inputEl.value.trim();
            if (!userPrompt) return;

            // Render User message
            appendChatMessage('user', userPrompt);
            inputEl.value = '';

            // Render Loading AI typing state
            const loadingId = appendChatMessage('ai', '<i class="fa-solid fa-spin fa-spinner text-orange-400 mr-2"></i> Analyzing symptoms with Mero AI Mechanic...');

            try {
                // Call Gemini 3 Flash API
                const systemPrompt = "You are 'Mero AI Mechanic' (मेरो AI मेकानिक), an expert auto-mechanical diagnostic assistant in Chitwan, Nepal. Provide concise, friendly diagnostic advice in 2-3 short bullet points. Always conclude with the recommended repair category (e.g., 'Scooter Drive Belt Replacement' or 'Car Battery Jumpstart') and estimated NPR cost.";
                const apiKey = ""; // Canvas runtime key
                const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

                const response = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        contents: [{ parts: [{ text: userPrompt }] }],
                        systemInstruction: { parts: [{ text: systemPrompt }] }
                    })
                });

                const data = await response.json();
                const aiText = data.candidates?.[0]?.content?.parts?.[0]?.text || "I recommend pulling over safely. Our nearest mobile mechanic in Bharatpur can assist you shortly.";

                // Replace loading message
                updateChatMessage(loadingId, aiText);

                // Auto-fill initial booking form based on prompt keywords
                autoPopulateBookingFromAI(userPrompt);

            } catch (err) {
                // Fallback smart offline diagnosis if network fails
                setTimeout(() => {
                    const fallbackDiag = `<strong>AI Diagnostic Summary:</strong><br>• Possible symptom: Spark plug fouling or fuel feed block.<br>• Safety Tip: Turn on hazard indicators and park off the main highway belt.<br>• Recommended Service: <strong>Emergency Mechanic Mobile Dispatch (रु 450 NPR)</strong>. Form auto-filled below!`;
                    updateChatMessage(loadingId, fallbackDiag);
                    autoPopulateBookingFromAI(userPrompt);
                }, 1000);
            }
        }

