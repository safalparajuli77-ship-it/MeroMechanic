                </div>
            </div>

        </div>
    </section>

    <!-- INBUILT AI MECHANIC ASSISTANT ("MERO AI MECHANIC" - GEMINI API POWERED) -->
    <section id="ai-assistant" class="py-16 px-4 lg:px-8 bg-gradient-to-b from-zinc-950 via-zinc-900 to-zinc-950 border-y border-zinc-800">
        <div class="max-w-7xl mx-auto">
            <div class="text-center max-w-3xl mx-auto mb-10">
                <span class="text-xs font-bold text-orange-400 tracking-widest uppercase bg-orange-950/50 border border-orange-500/30 px-3 py-1.5 rounded-full">
                    <i class="fa-solid fa-wand-magic-sparkles mr-1"></i> AI Powered Mechanical Diagnosis
                </span>
                <h2 class="heading-font text-3xl sm:text-4xl font-black text-white mt-3">Mero AI Mechanic (मेरो AI मेकानिक)</h2>
                <p class="text-zinc-400 text-sm sm:text-base mt-2">Not sure what's wrong with your vehicle? Describe symptoms in Nepali or English — our AI will diagnose the issue, provide safety tips, and auto-populate your booking.</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                
                <!-- Quick Symptom Preset Buttons -->
                <div class="lg:col-span-4 bg-zinc-900 border border-zinc-800 p-6 rounded-2xl space-y-4">
                    <h3 class="text-sm font-bold text-white uppercase tracking-wider flex items-center gap-2">
                        <i class="fa-solid fa-bolt text-yellow-400"></i> Common Chitwan Breakdown Prompts
                    </h3>
                    <p class="text-xs text-zinc-400">Click any preset symptom to auto-test AI diagnosis:</p>

                    <div class="space-y-2.5">
                        <button onclick="triggerAIPrompt('My scooter stopped near Pulchowk, heavy noise when accelerating, wheel stuck.')" class="w-full text-left p-3 rounded-xl bg-zinc-950 hover:bg-zinc-800 border border-zinc-800/80 transition text-xs text-zinc-300 flex items-center justify-between group">
                            <span><i class="fa-solid fa-motorcycle text-orange-400 mr-2"></i> Scooter Drive Belt Snap (Pulchowk)</span>
                            <i class="fa-solid fa-chevron-right text-zinc-600 group-hover:text-orange-400"></i>
                        </button>

                        <button onclick="triggerAIPrompt('EV Car battery depleted near Muglin highway slope, warning light flashing, need charging assist.')" class="w-full text-left p-3 rounded-xl bg-zinc-950 hover:bg-zinc-800 border border-zinc-800/80 transition text-xs text-zinc-300 flex items-center justify-between group">
                            <span><i class="fa-solid fa-bolt-lightning text-emerald-400 mr-2"></i> EV Car Low Battery (Muglin Slope)</span>
                            <i class="fa-solid fa-chevron-right text-zinc-600 group-hover:text-orange-400"></i>
                        </button>

                        <button onclick="triggerAIPrompt('Car engine smoking near Chaubiskothi Hospital Road, coolant leaking, temperature needle high.')" class="w-full text-left p-3 rounded-xl bg-zinc-950 hover:bg-zinc-800 border border-zinc-800/80 transition text-xs text-zinc-300 flex items-center justify-between group">
                            <span><i class="fa-solid fa-temperature-full text-red-400 mr-2"></i> Engine Overheating (Chaubiskothi)</span>
                            <i class="fa-solid fa-chevron-right text-zinc-600 group-hover:text-orange-400"></i>
                        </button>

                        <button onclick="triggerAIPrompt('Bike starter clicking sound but won\'t turn on at night near Lions Chowk.')" class="w-full text-left p-3 rounded-xl bg-zinc-950 hover:bg-zinc-800 border border-zinc-800/80 transition text-xs text-zinc-300 flex items-center justify-between group">
                            <span><i class="fa-solid fa-battery-quarter text-yellow-400 mr-2"></i> Dead Bike Battery (Lions Chowk)</span>
                            <i class="fa-solid fa-chevron-right text-zinc-600 group-hover:text-orange-400"></i>
                        </button>
                    </div>

                    <div class="bg-orange-950/20 border border-orange-500/20 p-3 rounded-xl text-[11px] text-orange-300 flex items-start gap-2 mt-4">
                        <i class="fa-solid fa-circle-info text-base text-orange-400 mt-0.5"></i>
                        <span>AI automatically matches symptoms with our standardized Chitwan Rate Card in NPR.</span>
                    </div>
                </div>

                <!-- Interactive Chat Box Interface -->
                <div class="lg:col-span-8 bg-zinc-900 border border-zinc-800 rounded-2xl flex flex-col h-[520px] overflow-hidden shadow-2xl">
                    
                    <!-- Chat Header -->
                    <div class="bg-zinc-950 px-6 py-4 border-b border-zinc-800 flex justify-between items-center">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-orange-500 to-yellow-500 text-zinc-950 flex items-center justify-center font-black text-lg shadow-lg">
                                <i class="fa-solid fa-robot"></i>
                            </div>
                            <div>
                                <h3 class="font-bold text-sm text-white flex items-center gap-2">
                                    Mero AI Mechanical Assistant
                                    <span class="text-[10px] bg-emerald-950 text-emerald-400 border border-emerald-800 px-2 py-0.5 rounded-full">Gemini 3 Flash</span>
                                </h3>
                                <p class="text-xs text-zinc-400">Real-time symptom analysis & safety advisor</p>
                            </div>
                        </div>
                        <button onclick="clearAIChat()" class="text-xs text-zinc-400 hover:text-white underline">Clear Chat</button>
                    </div>

                    <!-- Chat Messages Log Container -->
                    <div id="ai-chat-messages" class="flex-1 p-6 overflow-y-auto space-y-4 text-xs sm:text-sm">
                        <!-- Default AI Welcome Message -->
                        <div class="flex items-start gap-3">
                            <div class="w-8 h-8 rounded-lg bg-orange-500/20 text-orange-400 flex items-center justify-center font-bold flex-shrink-0">
                                <i class="fa-solid fa-robot"></i>
                            </div>
                            <div class="bg-zinc-950 border border-zinc-800 p-4 rounded-2xl rounded-tl-none max-w-xl text-zinc-300 space-y-2">
                                <p class="font-semibold text-white">Namaste! I am Mero AI Mechanic (मेरो AI मेकानिक).</p>
                                <p>Describe your vehicle issue (e.g., <em>"Engine overheating near Ramnagar"</em> or <em>"EV scooter error light on Pulchowk"</em>). I will analyze the cause, give safety instructions, and pre-fill your emergency repair booking.</p>
                            </div>
                        </div>
                    </div>

