<!DOCTYPE html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mero Mechanic - Nepal's #1 On-Demand Roadside Assistance & Vehicle Servicing</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts (Inter & Outfit) -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@600;700;800&display=swap" rel="stylesheet">
    <!-- Leaflet OpenMaps Integration (Full Google Maps JS API alternative with seamless custom markers & route drawing) -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            red: '#FF3B30',
                            orange: '#FF9500',
                            dark: '#0A0A0C',
                            card: '#18181B',
                            accent: '#F97316'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        outfit: ['Outfit', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #09090b;
            color: #f4f4f5;
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
        }
        .heading-font {
            font-family: 'Outfit', sans-serif;
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #18181b;
        }
        ::-webkit-scrollbar-thumb {
            background: #3f3f46;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #f97316;
        }
        /* Radar pulsing animation for live map */
        @keyframes pulse-ring {
            0% { transform: scale(0.95); opacity: 0.8; }
            50% { transform: scale(1.3); opacity: 0.3; }
            100% { transform: scale(1.6); opacity: 0; }
        }
        .radar-pulse {
            animation: pulse-ring 2s infinite ease-out;
        }
        .glow-red {
            box-shadow: 0 0 25px rgba(255, 59, 48, 0.35);
        }
        .glow-orange {
            box-shadow: 0 0 25px rgba(255, 149, 0, 0.3);
        }
        /* Leaflet Map Dark Styling Override */
        .leaflet-container {
            background: #09090b !important;
            font-family: 'Inter', sans-serif;
        }
        .leaflet-popup-content-wrapper {
            background: #18181b !important;
            color: #f4f4f5 !important;
            border: 1px solid #3f3f46 !important;
            border-radius: 12px !important;
            padding: 4px !important;
        }
        .leaflet-popup-tip {
            background: #18181b !important;
        }
    </style>
</head>
<body class="bg-zinc-950 text-zinc-100 antialiased selection:bg-orange-500 selection:text-white">

    <!-- Top Emergency SOS Ticker Bar -->
    <div class="bg-gradient-to-r from-red-600 via-orange-600 to-red-600 text-white py-2 px-4 text-xs md:text-sm font-semibold flex justify-between items-center z-50 relative">
        <div class="flex items-center space-x-2 animate-pulse">
            <i class="fa-solid font-bold fa-triangle-exclamation"></i>
            <span>Chitwan & Highway Emergency Cell Active: Narayangarh - Muglin & Mahendra Highway</span>
        </div>
        <div class="flex items-center space-x-4">
            <a href="tel:9800000000" onclick="triggerHotlineCall(event)" class="hover:underline flex items-center gap-1 font-bold bg-black/30 px-3 py-1 rounded-full border border-white/20">
                <i class="fa-solid fa-phone-volume text-yellow-300"></i> SOS Hotline: 9800-000-000
            </a>
        </div>
    </div>

    <!-- Navigation Header -->
    <nav class="sticky top-0 z-40 bg-zinc-900/90 backdrop-blur-md border-b border-zinc-800/80 px-4 lg:px-8 py-3 transition-all">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <!-- Brand Logo -->
            <div class="flex items-center gap-3 cursor-pointer" onclick="scrollToTop()">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-red-500 to-orange-500 flex items-center justify-center text-white text-xl font-black shadow-lg shadow-orange-500/20">
                    <i class="fa-solid fa-wrench"></i>
                </div>
                <div>
                    <span class="heading-font text-2xl font-black tracking-tight text-white">Mero<span class="text-orange-500">Mechanic</span></span>
                    <span class="block text-[10px] text-zinc-400 -mt-1 tracking-wider uppercase font-semibold">Chitwan & Bharatpur Hub</span>
                </div>
            </div>

            <!-- Desktop Nav Links -->
            <div class="hidden md:flex items-center gap-8 font-medium text-sm text-zinc-300">
                <a href="#ai-assistant" class="hover:text-orange-500 transition flex items-center gap-1 text-orange-400 font-bold"><i class="fa-solid fa-robot"></i> Mero AI Mechanic</a>
                <a href="#google-maps-section" class="hover:text-orange-500 transition"><i class="fa-solid fa-map-location-dot text-red-500 mr-1"></i> Nearby Garages & Map</a>
                <a href="#services" class="hover:text-orange-500 transition">Services & Rates</a>
                <a href="#highways" class="hover:text-orange-500 transition">Highway Grid</a>
                <a href="#join-mechanic" class="hover:text-orange-500 transition">Partner With Us</a>
            </div>

            <!-- Header Action Buttons -->
            <div class="flex items-center gap-3">
                <button onclick="scrollToAI()" class="flex items-center gap-2 text-xs font-semibold text-orange-400 bg-orange-950/40 hover:bg-orange-900/40 border border-orange-500/30 px-3 py-2 rounded-lg transition">
                    <i class="fa-solid fa-wand-magic-sparkles"></i> AI Diagnose
                </button>
                <button onclick="scrollToDispatch()" class="bg-gradient-to-r from-red-600 to-orange-500 hover:from-red-500 hover:to-orange-400 text-white font-bold text-xs sm:text-sm px-4 py-2.5 rounded-lg shadow-lg shadow-red-600/30 transition transform active:scale-95 flex items-center gap-2">
                    <i class="fa-solid fa-bolt"></i>
                    <span>Quick SOS Dispatch</span>
                </button>
            </div>
        </div>
    </nav>

    <!-- MAIN HERO SECTION & BOOKING ENGINE -->
    <section class="relative min-h-[90vh] pt-8 pb-16 px-4 lg:px-8 overflow-hidden flex flex-col justify-center">
        <!-- Background Decorative Elements -->
        <div class="absolute -top-32 -left-32 w-96 h-96 bg-red-600/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute top-1/2 -right-32 w-96 h-96 bg-orange-600/10 rounded-full blur-3xl pointer-events-none"></div>
        
        <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center relative z-10">
            
            <!-- Hero Left Text Content -->
            <div class="lg:col-span-6 space-y-6">
                <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-zinc-800/80 border border-zinc-700 text-xs font-semibold text-orange-400">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    Chitwan Pilot: 85+ Mechanics On-Call in Bharatpur & Highways
                </div>
                
                <h1 class="heading-font text-4xl sm:text-5xl lg:text-6xl font-black text-white leading-tight">
                    Vehicle Breakdown in Chitwan? <br>
                    <span class="bg-gradient-to-r from-red-500 via-orange-400 to-yellow-400 bg-clip-text text-transparent">
                        AI & GPS Mechanic Dispatch.
                    </span>
                </h1>
                
                <p class="text-zinc-400 text-base sm:text-lg leading-relaxed max-w-xl">
                    Instant emergency repairs for Bikes, EV Scooters, Cars, EVs, Micro Buses & Heavy Trucks across Pulchowk, Lions Chowk, Chaubiskothi, Gaindakot & Muglin Highway.
                </p>

                <!-- Key Highlights List -->
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-2">
                    <div class="bg-zinc-900/60 border border-zinc-800/80 p-3 rounded-xl flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg bg-red-500/20 text-red-400 flex items-center justify-center text-lg">
                            <i class="fa-solid fa-stopwatch"></i>
                        </div>
                        <div>
                            <p class="text-xs text-zinc-400">Bharatpur Arrival</p>
                            <p class="font-bold text-sm text-zinc-100">10 - 20 Mins</p>
                        </div>
                    </div>

                    <div class="bg-zinc-900/60 border border-zinc-800/80 p-3 rounded-xl flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg bg-orange-500/20 text-orange-400 flex items-center justify-center text-lg">
                            <i class="fa-solid fa-bolt"></i>
                        </div>
                        <div>
                            <p class="text-xs text-zinc-400">EV & Petrol</p>
                            <p class="font-bold text-sm text-zinc-100">All Categories</p>
                        </div>
                    </div>

                    <div class="bg-zinc-900/60 border border-zinc-800/80 p-3 rounded-xl flex items-center gap-3 col-span-2 sm:col-span-1">
                        <div class="w-9 h-9 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-lg">
                            <i class="fa-solid fa-robot"></i>
                        </div>
                        <div>
                            <p class="text-xs text-zinc-400">AI Powered</p>
                            <p class="font-bold text-sm text-zinc-100">Gemini Assistant</p>
                        </div>
                    </div>
                </div>

                <!-- App Store/Social Proof badges -->
                <div class="pt-4 flex items-center gap-4 text-xs text-zinc-400">
                    <span class="flex items-center gap-1"><i class="fa-solid fa-star text-yellow-400"></i> 4.9/5 Chitwan Rating</span>
                    <span>•</span>
                    <span>3,200+ Local Breakdown Jobs Done</span>
                </div>
            </div>

            <!-- Hero Right Interactive Booking Card -->
            <div class="lg:col-span-6">
                <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 shadow-2xl shadow-black/80 relative">
                    
                    <!-- Booking Mode Toggle Header -->
                    <div class="flex p-1 bg-zinc-950 rounded-xl mb-6 border border-zinc-800">
                        <button id="mode-emergency-btn" onclick="toggleBookingMode('emergency')" class="flex-1 py-3 rounded-lg text-xs sm:text-sm font-bold transition flex items-center justify-center gap-2 bg-gradient-to-r from-red-600 to-orange-500 text-white shadow-md">
                            <i class="fa-solid fa-triangle-exclamation"></i> Emergency SOS Repair
                        </button>
                        <button id="mode-scheduled-btn" onclick="toggleBookingMode('scheduled')" class="flex-1 py-3 rounded-lg text-xs sm:text-sm font-bold transition flex items-center justify-center gap-2 text-zinc-400 hover:text-white">
                            <i class="fa-regular fa-calendar-check"></i> Book Servicing
                        </button>
                    </div>

                    <form id="hero-booking-form" onsubmit="handleInitialBookingSubmit(event)" class="space-y-4">
                        <!-- Vehicle Type Selector (Updated with EV & Micro bus categories) -->
                        <div>
                            <label class="block text-xs font-semibold text-zinc-300 uppercase tracking-wider mb-2">1. Select Vehicle Type</label>
                            <div class="grid grid-cols-3 sm:grid-cols-6 gap-2">
                                <button type="button" onclick="selectVehicle('bike')" id="vtype-bike" class="vehicle-btn border-2 border-orange-500 bg-orange-500/10 p-2.5 rounded-xl flex flex-col items-center gap-1 transition text-white">
                                    <i class="fa-solid fa-motorcycle text-lg text-orange-400"></i>
                                    <span class="text-[10px] font-bold">Bike/Scooty</span>
                                </button>
                                <button type="button" onclick="selectVehicle('ev2w')" id="vtype-ev2w" class="vehicle-btn border border-zinc-800 bg-zinc-950 p-2.5 rounded-xl flex flex-col items-center gap-1 transition text-zinc-400 hover:border-zinc-700">
                                    <i class="fa-solid fa-charging-station text-lg text-emerald-400"></i>
                                    <span class="text-[10px] font-bold">EV 2W/3W</span>
                                </button>
                                <button type="button" onclick="selectVehicle('car')" id="vtype-car" class="vehicle-btn border border-zinc-800 bg-zinc-950 p-2.5 rounded-xl flex flex-col items-center gap-1 transition text-zinc-400 hover:border-zinc-700">
                                    <i class="fa-solid fa-car text-lg"></i>
                                    <span class="text-[10px] font-bold">Car/SUV</span>
                                </button>
                                <button type="button" onclick="selectVehicle('evcar')" id="vtype-evcar" class="vehicle-btn border border-zinc-800 bg-zinc-950 p-2.5 rounded-xl flex flex-col items-center gap-1 transition text-zinc-400 hover:border-zinc-700">
                                    <i class="fa-solid fa-bolt-lightning text-lg text-emerald-400"></i>
                                    <span class="text-[10px] font-bold">EV Car/SUV</span>
                                </button>
                                <button type="button" onclick="selectVehicle('micro')" id="vtype-micro" class="vehicle-btn border border-zinc-800 bg-zinc-950 p-2.5 rounded-xl flex flex-col items-center gap-1 transition text-zinc-400 hover:border-zinc-700">
                                    <i class="fa-solid fa-van-shuttle text-lg"></i>
                                    <span class="text-[10px] font-bold">Micro/Van</span>
                                </button>
                                <button type="button" onclick="selectVehicle('heavy')" id="vtype-heavy" class="vehicle-btn border border-zinc-800 bg-zinc-950 p-2.5 rounded-xl flex flex-col items-center gap-1 transition text-zinc-400 hover:border-zinc-700">
                                    <i class="fa-solid fa-truck-monster text-lg"></i>
                                    <span class="text-[10px] font-bold">Heavy Truck</span>
                                </button>
                            </div>
                        </div>

                        <!-- Location Selector / GPS (Tailored for Chitwan Bharatpur) -->
                        <div>
                            <label class="block text-xs font-semibold text-zinc-300 uppercase tracking-wider mb-2">2. Pickup Location in Chitwan</label>
                            <div class="relative">
                                <i class="fa-solid fa-location-dot absolute left-3.5 top-3.5 text-red-500 text-base"></i>
                                <select id="pickup-location" onchange="syncLocationWithMap()" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl py-3 pl-10 pr-10 text-sm font-medium text-white focus:outline-none focus:border-orange-500 transition appearance-none">
                                    <option value="Pulchowk, Narayangarh">Pulchowk, Narayangarh Junction</option>
                                    <option value="Lions Chowk, Bharatpur">Lions Chowk, Bharatpur Metro</option>
                                    <option value="Chaubiskothi, Bharatpur">Chaubiskothi (Near Hospital Road)</option>
                                    <option value="Paras Buspark, Narayangarh">Paras Buspark Area</option>
                                    <option value="Hakim Chowk / Rampur">Hakim Chowk & Rampur Road</option>
                                    <option value="Gaindakot (Narayani Bridge Belt)">Gaindakot (Across Narayani River)</option>
                                    <option value="Narayangarh-Muglin Highway (Ramnagar - Dasdhunga)">Narayangarh-Muglin Highway (Ramnagar - Dasdhunga)</option>
                                    <option value="Ratnanagar / Tandi / Sauraha Gate">Ratnanagar / Tandi / Sauraha Gate</option>
                                </select>
                                <button type="button" onclick="detectGPSLocation()" class="absolute right-3 top-2.5 bg-zinc-800 hover:bg-zinc-700 text-orange-400 p-1.5 rounded-lg text-xs font-semibold flex items-center gap-1 transition" title="Detect GPS">
                                    <i class="fa-solid fa-crosshairs"></i> <span class="hidden sm:inline">GPS</span>
                                </button>
                            </div>
                            <p id="gps-status" class="text-[11px] text-zinc-500 mt-1 flex items-center gap-1 hidden">
                                <i class="fa-solid fa-circle-check text-emerald-500"></i> GPS Location Acquired: <span id="gps-coords" class="text-zinc-300 font-mono">27.6792° N, 84.4321° E (Bharatpur)</span>
                            </p>
                        </div>

                        <!-- Service Issue Selection -->
                        <div>
                            <label class="block text-xs font-semibold text-zinc-300 uppercase tracking-wider mb-2">3. Required Service / Issue</label>
                            <select id="service-issue" onchange="updateEstimatedPrice()" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl py-3 px-3 text-sm font-medium text-white focus:outline-none focus:border-orange-500 transition">
                                <!-- Dynamic Options Populated by JS -->
                            </select>
                        </div>

                        <!-- Price Preview Banner -->
                        <div class="bg-zinc-950/80 border border-zinc-800 rounded-xl p-3.5 flex justify-between items-center">
                            <div>
                                <span class="text-xs text-zinc-400 block">Upfront Estimated Cost</span>
                                <span class="text-[11px] text-emerald-400">Includes dispatch fee & local mistri charge</span>
                            </div>
                            <div class="text-right">
                                <span id="estimated-price" class="text-2xl font-black text-orange-400">रु 450</span>
                                <span class="text-xs text-zinc-500 block">NPR (Inc. Taxes)</span>
                            </div>
                        </div>

                        <!-- Submit Dispatch Button -->
                        <button type="submit" class="w-full bg-gradient-to-r from-red-600 via-orange-500 to-red-600 hover:from-red-500 hover:to-orange-400 text-white font-black py-4 rounded-xl shadow-lg shadow-red-600/30 transition transform active:scale-98 flex items-center justify-center gap-3 text-base uppercase tracking-wider">
                            <i class="fa-solid fa-location-arrow animate-bounce"></i>
                            <span id="submit-btn-text">Dispatch Emergency Mechanic Now</span>
                        </button>
