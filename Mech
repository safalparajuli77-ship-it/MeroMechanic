            // Reset Timeline
            document.getElementById('step-2').className = "flex items-start gap-4 relative z-10 opacity-40 transition-all duration-500";
            document.getElementById('step-3').className = "flex items-start gap-4 relative z-10 opacity-40 transition-all duration-500";
            document.getElementById('step-4').className = "flex items-start gap-4 relative z-10 opacity-40 transition-all duration-500";
            document.getElementById('mechanic-card').classList.add('hidden');

            statusText.innerHTML = '<i class="fa-solid fa-spin fa-spinner text-orange-400 mr-2"></i> Locating nearest active mechanic in Chitwan grid...';

            // Phase 1: Mechanic Found (2 Secs)
            setTimeout(() => {
                document.getElementById('step-2').classList.remove('opacity-40');
                document.getElementById('step-2-icon').className = "w-7 h-7 rounded-full bg-emerald-500 text-zinc-950 flex items-center justify-center text-xs font-bold ring-4 ring-zinc-900";
                document.getElementById('step-2-desc').textContent = "Bikram Maharjan accepted your Chitwan SOS booking!";
                statusText.innerHTML = '<i class="fa-solid fa-check-circle text-emerald-400 mr-2"></i> Mechanic Assigned: Bikram Maharjan';

                const pin1 = document.getElementById('mechanic-pin-1');
                if(pin1) { pin1.style.top = "42%"; pin1.style.left = "38%"; }
            }, 2000);

            // Phase 2: En Route (4 Secs)
            setTimeout(() => {
                document.getElementById('step-3').classList.remove('opacity-40');
                document.getElementById('step-3-icon').className = "w-7 h-7 rounded-full bg-orange-500 text-zinc-950 flex items-center justify-center text-xs font-bold ring-4 ring-zinc-900";
                document.getElementById('step-3-desc').textContent = "Bikram is driving towards your Chitwan location.";
                document.getElementById('mechanic-card').classList.remove('hidden');
                
                const pin1 = document.getElementById('mechanic-pin-1');
                if(pin1) { pin1.style.top = "48%"; pin1.style.left = "46%"; }
                document.getElementById('mechanic-eta').textContent = "2 Minutes";
                statusText.innerHTML = '<i class="fa-solid fa-person-biking text-orange-400 mr-2 animate-bounce"></i> Technician En Route from Lions Chowk...';
            }, 4000);

            // Phase 3: Arrived (6.5 Secs)
            setTimeout(() => {
                document.getElementById('step-4').classList.remove('opacity-40');
                document.getElementById('step-4-icon').className = "w-7 h-7 rounded-full bg-blue-500 text-white flex items-center justify-center text-xs font-bold ring-4 ring-zinc-900";
                document.getElementById('mechanic-eta').textContent = "ARRIVED AT SITE";
                statusText.innerHTML = '<i class="fa-solid fa-flag-checkered text-blue-400 mr-2"></i> Mechanic Arrived! Starting Inspection & Repair.';
                
                startBtn.disabled = false;
                startBtn.classList.remove('opacity-50');
                state.simState = 'arrived';
            }, 6500);
        }

        function resetSimulation() {
            state.simState = 'idle';
            const pin1 = document.getElementById('mechanic-pin-1');
            if(pin1) { pin1.style.top = "20%"; pin1.style.left = "15%"; }

            document.getElementById('step-2').className = "flex items-start gap-4 relative z-10 opacity-40 transition-all duration-500";
            document.getElementById('step-3').className = "flex items-start gap-4 relative z-10 opacity-40 transition-all duration-500";
            document.getElementById('step-4').className = "flex items-start gap-4 relative z-10 opacity-40 transition-all duration-500";
            document.getElementById('mechanic-card').classList.add('hidden');
            document.getElementById('sim-status-text').innerHTML = '<i class="fa-solid fa-circle-info text-orange-400 mr-2"></i> Simulation reset. Ready for new dispatch.';
        }

        // Render Service Rate Cards
        function renderRateCardGrid(filter) {
            const grid = document.getElementById('service-catalog-grid');
            if(!grid) return;
            grid.innerHTML = '';

            const items = filter === 'all' ? serviceCatalog : serviceCatalog.filter(s => s.category === filter);

            items.forEach(item => {
                const card = document.createElement('div');
                card.className = "bg-zinc-900 border border-zinc-800 rounded-2xl p-6 flex flex-col justify-between hover:border-zinc-700 transition group";
                card.innerHTML = `
                    <div>
                        <div class="flex justify-between items-start mb-3">
                            <span class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-md bg-zinc-800 text-orange-400 border border-zinc-700">
                                ${item.category}
                            </span>
                            <span class="text-xl font-black text-white">रु ${item.price}</span>
                        </div>
                        <h3 class="font-bold text-base text-white group-hover:text-orange-400 transition">${item.name}</h3>
                        <p class="text-xs text-zinc-400 mt-2 leading-relaxed">${item.desc}</p>
                    </div>
                    <div class="pt-6 border-t border-zinc-800/80 mt-4 flex items-center justify-between">
                        <span class="text-[11px] text-zinc-500 flex items-center gap-1">
                            <i class="fa-solid fa-clock text-orange-500"></i> ~15-25 min response
                        </span>
                        <button onclick="bookSpecificService('${item.id}')" class="text-xs font-bold text-orange-400 hover:text-orange-300 flex items-center gap-1">
                            Book Now <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function filterRateCard(cat) {
            document.querySelectorAll('.rate-tab').forEach(btn => {
                btn.className = "rate-tab px-4 py-2 rounded-lg text-xs font-bold text-zinc-400 hover:text-white";
            });
            const activeTab = document.getElementById(`filter-${cat}`);
            if(activeTab) activeTab.className = "rate-tab px-4 py-2 rounded-lg text-xs font-bold text-white bg-zinc-800";
            renderRateCardGrid(cat);
        }

        function bookSpecificService(id) {
            const item = serviceCatalog.find(s => s.id === id);
            if (item) {
                selectVehicle(item.vehicle);
                document.getElementById('service-issue').value = item.id;
                updateEstimatedPrice();
                scrollToTop();
            }
        }

        // Highway Zone Lookup Data
        function checkHighwayCoverage() {
            const val = document.getElementById('highway-zone-select').value;
            const hub = document.getElementById('cov-hub');
            const time = document.getElementById('cov-time');
            const srv = document.getElementById('cov-services');

            const highwayData = {
                nagdhunga: { hub: 'Nagdhunga SOS Patrol Station', time: '10 - 15 Mins', srv: 'Tire Repair, Tow Truck, Brake Check' },
                naubise: { hub: 'Naubise Junction Hub', time: '15 - 20 Mins', srv: 'Heavy Truck Repair, Jumpstart, Fuel' },
                malekhu: { hub: 'Malekhu Highway Cell', time: '12 - 18 Mins', srv: 'Bike Patch, Towing, Engine Oil' },
                kurintar: { hub: 'Kurintar Cablecar Outpost', time: '10 - 15 Mins', srv: '24/7 Mobile Mechanic, Towing' },
                muglin: { hub: 'Muglin Central Emergency Grid', time: '8 - 12 Mins', srv: 'Full Diagnostic, Heavy Recovery Unit' },
                ramnagar: { hub: 'Ramnagar Bharatpur Station', time: '15 - 20 Mins', srv: 'Scooter Belt, Battery Charge, Towing' },
                damauli: { hub: 'Damauli Kaski Highway Patrol', time: '15 - 25 Mins', srv: 'Tire Patch, Emergency Fuel' }
            };

            const selected = highwayData[val];
            if (selected) {
                hub.textContent = selected.hub;
                time.textContent = selected.time;
                srv.textContent = selected.srv;
            }
        }

        // Call Hotline Trigger Simulation
        function triggerHotlineCall(e) {
            if(e) e.preventDefault();
            alert("Dialing Mero Mechanic Chitwan Emergency Hotline: +977 9800-000-000\n\nConnecting Bharatpur location dispatch center...");
        }

        function simulateCallMechanic() {
            alert("Calling Assigned Mechanic: Bikram Maharjan (+977 9855-XXXXXX)\n\n'Namaste! I am passing Lions Chowk with the toolkit.'");
        }

        // Mechanic Partner Registration Handler
        function handleMechanicRegisterSubmit(e) {
            e.preventDefault();
            alert("Dhanyabad! Your mechanic application for Chitwan region has been received.\nOur Bharatpur team will contact you within 24 hours.");
            e.target.reset();
        }

        // Switch Persona tab
        function switchPersona(type) {
            if (type === 'mechanic') {
                document.getElementById('join-mechanic').scrollIntoView({ behavior: 'smooth' });
            }
        }

        // Modal Controls
        function openPaymentModal() {
            document.getElementById('payment-modal').classList.remove('hidden');
        }

        function closePaymentModal() {
            document.getElementById('payment-modal').classList.add('hidden');
        }

        function selectPaymentGateway(gw) {
            state.selectedPayment = gw;
            const buttons = ['esewa', 'khalti', 'ips', 'cod'];
            buttons.forEach(b => {
                const el = document.getElementById(`pay-${b}`);
                if(el) el.className = "p-3 border border-zinc-800 bg-zinc-950 rounded-xl flex items-center justify-center font-bold text-zinc-400 text-sm gap-2";
            });

            const active = document.getElementById(`pay-${gw}`);
            if(active) active.className = "p-3 border-2 border-orange-500 bg-orange-950/30 rounded-xl flex items-center justify-center font-bold text-orange-400 text-sm gap-2";
        }

        function processPaymentSuccess() {
            alert(`Payment Successful via ${state.selectedPayment.toUpperCase()}!\n\nTransaction Receipt sent via SMS. Dhanyabad!`);
            closePaymentModal();
        }
    </script>
</body>
</html>
