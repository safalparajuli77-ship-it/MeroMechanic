                        <i class="fa-solid fa-robot"></i>
                    </div>
                    <div id="${msgId}" class="bg-zinc-950 border border-zinc-800 p-4 rounded-2xl rounded-tl-none max-w-xl text-zinc-300 space-y-2">
                        ${text}
                    </div>
                `;
            }

            container.appendChild(div);
            container.scrollTop = container.scrollHeight;
            return msgId;
